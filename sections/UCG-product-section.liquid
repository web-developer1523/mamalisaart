<script>
   $('.product-slider-new').slick({
    centerMode: true,
    centerPadding: '0px',
    slidesToShow: 3,
    dots: false,
    arrows: true,
    responsive: [
       {
        breakpoint:1340,
        settings: {
          slidesToShow: 3
        }
      },
      {
        breakpoint:1200,
        settings: {
          slidesToShow: 3
        }
      },
      {
        breakpoint:789,
        settings: {
          slidesToShow: 1
        }
      }
    ]
  });
</script>
<style>
    .styled-by-you h2 {
      font-size: 40px;
      margin-top: 15px;
  }
    .styled-by-you a.cta-button:hover{
      border: 1px solid #ff9a15;
    }
      section.styled-by-you.page-width {
      padding: 36px 0px !important;
      }
      .styled-by-you a.cta-button {
      margin-top: 36px;
      margin-bottom: 36px;
        border: 1px solid #ff9a15;
      }
      .styled-by-you .slider-new .slick-slide {
      transform: scale(0.85);
      transition: transform 0.3s ease;
      }
      .styled-by-you .slider-new .slick-center {
      transform: scale(1);
      opacity: 1;
      }
      .styled-by-you  .slider-new .slick-slide .item-content {
      border-radius: 0;
      overflow: hidden;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);
      }
      .styled-by-you {
      text-align: center;
      padding: 95px 20px;
      }
      .styled-by-you h2 {
      font-size: 40px;
      }
      .styled-by-you p {
      font-size: 16px;
      }
      .styled-by-you .slider-new img.play-icon {
      filter: invert(1);
      }
      .styled-by-you .slider-new {
      margin-top: 30px;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      }
      .styled-by-you  .slider-new .item {
      padding: 0 10px;
      }
      .styled-by-you .slider-new .item-content {
      position: relative;
      overflow: hidden;
      }
      .styled-by-you .slider-new .item img,
      .slider .item video {
      width: 100%;
      height: 500px !important;
      display: block;
      object-fit: cover;
      }
      body .styled-by-you .slider-new img.play-icon {
      height: 30px !important;
      }
      .styled-by-you .slider-new .caption {
      font-size: 16px;
      padding-top: 30px;
      }
      .styled-by-you  .slick-dots {
      margin-top: 30px;
      }
      .styled-by-you .slick-dots li button:before{
      font-size: 10px;
      }
      .styled-by-you .slider-new .slick-dots {
      bottom: -55px;
      }
      .slick-prev:before, .slick-next:before {
      font-size: 30px;
      opacity: 1;
      color: #000;
      }
     .slick-next {
        right: 13px;
        z-index: 1;
     }
     .slick-prev {
      left: 5px;
      z-index: 1;
    }
</style>
{% schema %}
{
  "name": "UCG Product Section",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "name": "Slide",
      "type": "slide",
      "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "video",
            "id": "video",
            "label": "A Shopify-hosted video"
          },
          {
            "type": "text",
            "id": "brand",
            "label": "Text"
          },
      ]
    }
  ],
  "presets": [
    {
      "name": "UCG Product Section"
    }
  ]
}
{% endschema %}
